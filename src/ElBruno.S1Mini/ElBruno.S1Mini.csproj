<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ElBruno.S1Mini</PackageId>
    <Description>Local ASR transcript normalizer for .NET, wrapping superwhisper/s1-mini (0.6B Qwen3 fine-tune) via ONNX Runtime GenAI. Auto-downloads the INT4 ONNX model from HuggingFace and exposes a TranscriptNormalizer API plus IChatClient.</Description>
    <PackageProjectUrl>https://github.com/elbruno/ElBruno.S1Mini</PackageProjectUrl>
    <PackageIcon Condition="Exists('$(MSBuildThisFileDirectory)../../images/nuget_logo.png')">nuget_logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>s1-mini;asr;speech-to-text;transcript;normalizer;onnx;huggingface;local;ai;qwen3</PackageTags>
    <Version>0.2.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ElBruno.HuggingFace.Downloader" Version="0.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.15.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ElBruno.S1Mini.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../images/nuget_logo.png" Pack="true" PackagePath="/" Condition="Exists('$(MSBuildThisFileDirectory)../../images/nuget_logo.png')" />
  </ItemGroup>
</Project>
